# --- App ---
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ramsar_wetlands
# Local development without PostgreSQL (admin accounts + dataset history only):
# DATABASE_URL=sqlite:///./dev.db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# First administrator, created on startup only while there are no users.
# The password must be changed at first sign-in and cannot be reused.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin@wetlands

# --- Datasets ---
# Uploaded files (history) and the folder the portal reads published climate
# files from. Defaults: backend/storage and frontend/data/climate.
# DATA_STORAGE_DIR=./storage
# CLIMATE_PUBLISH_DIR=../frontend/data/climate
# RAMSAR_SITES_FILE=../frontend/data/ramsar-sites.json
MAX_UPLOAD_MB=25

# --- Copernicus Data Space / Sentinel Hub ---
# Never commit real credentials.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Endpoints (defaults shown; override only for testing).
# COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1
# COPERNICUS_STATISTICS_URL=https://sh.dataspace.copernicus.eu/statistics/v1
# COPERNICUS_CATALOG_URL=https://sh.dataspace.copernicus.eu/catalog/v1/search
# COPERNICUS_TIMEOUT_SECONDS=120

# --- Water-quality analysis geometry ---
# GEE ROI polygons exported as <geeAssetName>.geojson (see backend/data/roi/README.md).
# GEE_ROI_MANIFEST_FILE=./data/gee-roi-manifest.json
# WETLAND_ROI_DIR=./data/roi

# --- Google Earth Engine ---
EARTH_ENGINE_PROJECT=

# --- S3-compatible object storage ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
